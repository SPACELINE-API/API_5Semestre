{
	"expo": {
		"name": "mobile",
		"slug": "mobile",
		"version": "1.0.0",
		"orientation": "portrait",
		"scheme": "mobile",
		"userInterfaceStyle": "automatic",
		"android": {
			"predictiveBackGestureEnabled": false
		},
		"web": { "output": "static" },
		"plugins": ["expo-router", "expo-splash-screen"],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true,
			"router": {
				"root": "src"
			}
		}
	}
}
