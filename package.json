{
  "name": "api-5semestre",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm --filter @api/server install:python",
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @api/web dev",
    "dev:server": "pnpm --filter @api/server dev",
    "supabase:keys": "node scripts/generate-supabase-keys.js",
    "test:supabase:keys": "node --test scripts/generate-supabase-keys.test.js",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm lint:web && pnpm lint:server",
    "lint:web": "pnpm --filter web lint",
    "lint:server": "ruff check apps/server",
    "lint:fix": "pnpm lint:web:fix && pnpm lint:server:fix",
    "lint:web:fix": "pnpm --filter web lint:fix",
    "lint:server:fix": "ruff check apps/server --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript-eslint": "^8.70.0"
  },
  "type": "module"
}
